<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#080A10">
    <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubTextBrush" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0070D1" />

        <!-- Own list templates so the active Playnite theme's ListBox style (which disables horizontal scrolling) is not used -->
        <ControlTemplate x:Key="HorizontalListTemplate" TargetType="ListBox">
            <ScrollViewer x:Name="ListScroller" Focusable="False" Padding="{TemplateBinding Padding}" Background="Transparent"
                          CanContentScroll="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ControlTemplate x:Key="PlainListTemplate" TargetType="ListBox">
            <ItemsPresenter />
        </ControlTemplate>
        <Style x:Key="PlainScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8" Opacity="0.5"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category tabs -->        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Margin" Value="0,0,38,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="Segoe UI" Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Underline" Height="3" Margin="0,6,0,0" CornerRadius="2" Background="White" Opacity="0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Game cards -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Width="236">
                            <Grid x:Name="CardRoot" Width="236" Height="330" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="Glow" CornerRadius="18" Margin="-7" BorderThickness="3" BorderBrush="White" Opacity="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="28" ShadowDepth="0" Opacity="0.75" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="14" Background="#1E232D">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}" FontSize="64" FontWeight="Bold" Foreground="#40FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="18" Foreground="#99FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                                                   Margin="14" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Shade" CornerRadius="14" Background="#55000000" />
                                <Border CornerRadius="10" Background="#E61DB954" Padding="8,3" Margin="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding IsOnPc, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="PC'de var" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <Border CornerRadius="10" Background="#E6FFFFFF" Padding="8,3" Margin="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding IsLibraryOnly, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Kütüphanede" FontSize="14" FontWeight="SemiBold" Foreground="#101318" />
                                </Border>
                                <TextBlock Text="★" FontSize="30" Foreground="#FFD54A" Margin="12,6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                            <TextBlock x:Name="CardTitle" Text="{Binding Title}" Margin="4,16,4,0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CardSubtitle}" Margin="4,2,4,0" FontSize="16" Foreground="#80FFFFFF" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                <Setter TargetName="Shade" Property="Opacity" Value="0" />
                                <Setter TargetName="CardTitle" Property="Foreground" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PS5 pill buttons -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="34,0" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="36" Margin="-5" BorderThickness="2.5" BorderBrush="White" Opacity="0" />
                            <Border x:Name="Body" CornerRadius="32" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#101318" />
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Margin" Value="0,0,28,12" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Grid.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" ClipToBounds="True" TextOptions.TextFormattingMode="Display">
            <!-- Background: selected game art, blurred -->
            <Image Source="{Binding SelectedGame.Cover}" Stretch="UniformToFill" Opacity="0.42" Margin="-80">
                <Image.Effect>
                    <BlurEffect Radius="60" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F2080A10" Offset="0" />
                        <GradientStop Color="#B3080A10" Offset="0.55" />
                        <GradientStop Color="#4D080A10" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00080A10" Offset="0.45" />
                        <GradientStop Color="#F2080A10" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Store page -->
            <Grid Margin="96,48,0,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,96,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="PS2" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PlayStation Store" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="BD Soft PS2 Store" FontSize="16" Foreground="#80FFFFFF" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border CornerRadius="18" Background="#26FFFFFF" Padding="16,0" Height="54" Width="460">
                            <Grid>
                                <TextBlock Text="⌕" FontSize="28" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                <TextBlock Text="Oyun ara...  (ör. dirge)" FontSize="21" Foreground="#73FFFFFF" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="36,0,40,0"
                                         Foreground="White" CaretBrush="White" FontSize="22" VerticalAlignment="Center">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Button Content="✕" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Focusable="False" Cursor="Hand" Foreground="#B3FFFFFF" FontSize="18" Background="Transparent" BorderThickness="0"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <Button Content="✕  Kapat" Command="{Binding CloseCommand}" Style="{StaticResource PillButton}" Height="54" FontSize="19"
                                Padding="24,0" Margin="18,0,0,0" Focusable="False" />
                    </StackPanel>
                </Grid>

                <!-- Hero: selected game -->
                <Grid Grid.Row="1" Margin="0,24,96,10" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="1000" HorizontalAlignment="Left">
                        <Border CornerRadius="8" Background="#330070D1" BorderBrush="#990070D1" BorderThickness="1" Padding="12,4" HorizontalAlignment="Left">
                            <TextBlock Text="PLAYSTATION 2" FontSize="16" FontWeight="SemiBold" Foreground="#9FD0FF" />
                        </Border>
                        <TextBlock Text="{Binding SelectedGame.Title}" FontSize="56" FontWeight="SemiBold" Foreground="White"
                                   TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="64" MaxHeight="136" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedGame.HeroMeta}" FontSize="24" Foreground="#CCFFFFFF" Margin="0,14,0,0" />
                        <TextBlock FontSize="20" Foreground="#99FFFFFF" Margin="0,8,0,0" TextWrapping="Wrap">
                            <Run Text="Yayıncı: " /><Run Text="{Binding SelectedGame.PublishersText, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                            <Border CornerRadius="10" Padding="12,5" Margin="0,0,12,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGame.IsOnPc}" Value="True">
                                                <Setter Property="Background" Value="#E61DB954" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedGame.AvailabilityText}" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <Border CornerRadius="10" Background="#33FFD54A" Padding="12,5"
                                    Visibility="{Binding SelectedGame.IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="★  Favori" FontSize="17" FontWeight="SemiBold" Foreground="#FFD54A" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="236" Height="320" CornerRadius="18" Margin="40,0,20,0" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding SelectedGame.Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.7" />
                        </Border.Effect>
                    </Border>
                </Grid>

                <!-- Category tabs + result count -->
                <StackPanel Grid.Row="2" Margin="0,0,96,18">
                    <ListBox x:Name="TabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource TabItemStyle}" Template="{StaticResource PlainListTemplate}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Contained">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="{Binding ResultText}" FontSize="20" Foreground="#99FFFFFF" Margin="0,14,0,0" />
                </StackPanel>

                <!-- Game cards -->
                <Grid Grid.Row="3" Height="420">
                    <ListBox x:Name="GameList" ItemsSource="{Binding VisibleGames}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CardItemStyle}" Template="{StaticResource HorizontalListTemplate}" Background="Transparent" BorderThickness="0" Padding="22,22,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             KeyboardNavigation.DirectionalNavigation="Contained">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="Sonuç bulunamadı." FontSize="26" Foreground="#99FFFFFF" Margin="12,60,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Controller hints -->
                <TextBlock Grid.Row="4" FontSize="17" Foreground="#80FFFFFF" Margin="0,8,96,0">
                    Ⓐ Ayrıntılar   ·   Ⓑ Kapat   ·   Ⓧ Ara   ·   Ⓨ Favori   ·   LB / RB Kategori   ·   Klavye: Enter, Esc, Ctrl+F, F
                </TextBlock>
            </Grid>

            <!-- Game detail page -->
            <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
                <Image Source="{Binding DetailGame.Cover}" Stretch="UniformToFill" Opacity="0.35" Margin="-80">
                    <Image.Effect>
                        <BlurEffect Radius="70" KernelType="Gaussian" />
                    </Image.Effect>
                </Image>
                <Border Background="#E6080A10" />

                <Grid Margin="120,90,120,70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="460" Height="640" VerticalAlignment="Top">
                        <Border CornerRadius="22" Background="#1E232D">
                            <TextBlock Text="{Binding DetailGame.Initials}" FontSize="110" FontWeight="Bold" Foreground="#33FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="22">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding DetailGame.Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="50" ShadowDepth="12" Opacity="0.75" />
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="80,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border CornerRadius="8" Background="#330070D1" BorderBrush="#990070D1" BorderThickness="1" Padding="12,4" HorizontalAlignment="Left">
                                <TextBlock Text="PLAYSTATION 2" FontSize="16" FontWeight="SemiBold" Foreground="#9FD0FF" />
                            </Border>
                            <TextBlock Text="{Binding DetailGame.Title}" FontSize="56" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,14,0,24" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bu PC'de" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailGame.AvailabilityText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource InfoValue}">
                                        <Setter Property="Foreground" Value="#FFB0B0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailGame.IsOnPc}" Value="True">
                                                <Setter Property="Foreground" Value="#5BE38A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DetailGame.IsLibraryOnly}" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailGame.Platform}" Style="{StaticResource InfoValue}" Margin="0,0,40,12" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Çıkış yılı" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DetailGame.YearText}" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Yayıncı" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailGame.PublishersText}" Style="{StaticResource InfoValue}" Margin="0,0,40,12" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Geliştirici" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DetailGame.DevelopersText}" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tür" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailGame.GenresText}" Style="{StaticResource InfoValue}" Margin="0,0,40,12" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Seri no" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DetailGame.Serial}" Style="{StaticResource InfoValue}" />
                        </Grid>

                        <ScrollViewer x:Name="DescriptionScroller" Grid.Row="2" Style="{StaticResource PlainScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="0,8,0,20" Focusable="False">
                            <TextBlock Text="{Binding DetailGame.Description}" FontSize="21" Foreground="#D9FFFFFF" TextWrapping="Wrap" LineHeight="32" />
                        </ScrollViewer>

                        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="19" Foreground="#9FD0FF" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

                        <WrapPanel Grid.Row="4" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <Button x:Name="BtnPlay" Content="▶  Oyna" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryPillButton}"
                                    Visibility="{Binding DetailGame.IsPlayable, Converter={StaticResource BoolToVisibility}}" />
                            <Button x:Name="BtnInstall" Content="Kur" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryPillButton}" />
                            <Button x:Name="BtnLibrary" Content="{Binding DetailGame.LibraryButtonText}" Command="{Binding AddToLibraryCommand}" Style="{StaticResource PrimaryPillButton}" />
                            <Button x:Name="BtnFind" Content="📂  Oyunu Bul (kendi dosyan)" Command="{Binding FindFileCommand}" Style="{StaticResource PillButton}" />
                            <Button x:Name="BtnFavorite" Content="{Binding DetailGame.FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource PillButton}" />
                            <Button x:Name="BtnBack" Content="Geri" Command="{Binding CloseDetailCommand}" Style="{StaticResource PillButton}" />
                        </WrapPanel>
                    </Grid>
                </Grid>

                <TextBlock FontSize="17" Foreground="#80FFFFFF" Margin="120,0,0,28" VerticalAlignment="Bottom">
